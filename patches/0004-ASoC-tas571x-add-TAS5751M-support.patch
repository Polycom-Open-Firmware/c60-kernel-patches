From 831f611d7861fc80c76956d8d50cc17a8ab2f1a8 Mon Sep 17 00:00:00 2001
From: Poly Open Firmware <alex.camilo@gmail.com>
Date: Wed, 1 Jul 2026 19:46:24 +0000
Subject: [PATCH] ASoC: tas571x: add TAS5751M support

The TAS5751M is a closed-loop BD-modulation class-D amplifier used on the
Poly Trio C60 (i.MX 8M Mini "Kepler").  It is register-compatible with the
TAS5717 (2-byte volume registers, same regmap layout) but needs a
board-specific coefficient sequence, and the generic tas571x path mishandles
it in two ways that hard-hang the SoC the instant the amp drives a non-silent
signal (silence plays fine):

1. tas571x_register_size() does not list the 32-bit coefficient registers
   0x50, 0x56, 0x57, 0x71 and 0x75, so writes to them are truncated to a
   single byte (the LSB) and the BD output-mixer / pre/post-scale
   coefficients are corrupted.  Add all five to the 4-byte set.

2. Nothing programs the BD-modulation routing, so the bridge runs with a
   unity output mix, no output scaling, a 98.4% modulation limit and a
   ~+22 dB master gain.  That overdrives the bridge into cross-conduction /
   PVDD brownout and hangs the SoC as soon as a real waveform is played.

Add a .init() callback to struct tas571x_chip, invoked from
tas571x_i2c_probe() right after the OSC_TRIM=0 + 50 ms settle, and a
tas5751_chip whose init replays the exact 27-register stock recipe
(reverse-engineered from tas5751m_kepler_config): pre/post-scale, master and
channel volumes, BD input mux, PWM output mux, the 0.5x output cross-mix
coefficients, 93.8% modulation limit and BD inter-channel delays, exiting
all-channel shutdown (SYS_CTRL_2 = 0x00) last.  OSC_TRIM (0x1B) is left at
the factory value loaded by the probe settle.

Finally, cap the exposed master/channel volume controls (RANGE_TLV) at the
stock -6 dB / 0 dB operating point and do not expose the output-mixer
coefficient controls, so no amixer or alsactl-restore value can raise the
BD mix or master gain back into the hang.

Signed-off-by: Poly Open Firmware <alex.camilo@gmail.com>
---
 sound/soc/codecs/tas571x.c | 123 +++++++++++++++++++++++++++++++++++++
 1 file changed, 123 insertions(+)

diff --git a/sound/soc/codecs/tas571x.c b/sound/soc/codecs/tas571x.c
index 1756edb35..c9d012be1 100644
--- a/sound/soc/codecs/tas571x.c
+++ b/sound/soc/codecs/tas571x.c
@@ -33,6 +33,8 @@
 
 #define TAS571X_MAX_SUPPLIES		6
 
+struct tas571x_private;
+
 struct tas571x_chip {
 	const char			*const *supply_names;
 	int				num_supply_names;
@@ -40,6 +42,7 @@ struct tas571x_chip {
 	int				num_controls;
 	const struct regmap_config	*regmap_config;
 	int				vol_reg_size;
+	int				(*init)(struct tas571x_private *priv);
 };
 
 struct tas571x_private {
@@ -67,6 +70,17 @@ static int tas571x_register_size(struct tas571x_private *priv, unsigned int reg)
 	case TAS5717_CH1_LEFT_CH_MIX_REG:
 	case TAS5717_CH2_LEFT_CH_MIX_REG:
 	case TAS5717_CH2_RIGHT_CH_MIX_REG:
+	/*
+	 * TAS5751M 32-bit output-mixer / scale coefficients (Poly Trio C60
+	 * stock init recipe). Mainline never lists these, so without them
+	 * tas571x_reg_write() would emit a single byte and truncate the
+	 * coefficient to its LSB, corrupting the BD-modulation routing.
+	 */
+	case 0x50:	/* output scale               */
+	case 0x56:	/* post-scale                 */
+	case 0x57:	/* pre-scale                  */
+	case 0x71:	/* ch1 output-mixer coeff     */
+	case 0x75:	/* ch2 output-mixer coeff     */
 		return 4;
 	default:
 		return 1;
@@ -785,6 +799,105 @@ static const struct tas571x_chip tas5721_chip = {
 	.vol_reg_size			= 1,
 };
 
+/*
+ * TAS5751M (Poly Trio C60 "Kepler") — stock power-amp init recipe.
+ *
+ * The TAS5751M is register-compatible with the TAS5717 (2-byte volume
+ * registers, same regmap layout), but the Polycom board runs it in
+ * closed-loop BD modulation and the part stays in all-channel shutdown
+ * until a board-specific coefficient sequence is programmed.
+ *
+ * This is the exact 27-register sequence the stock firmware writes,
+ * reverse-engineered from tas5751m_kepler_config.  Ordering matters: the
+ * BD input mux (0x20), the inter-channel delays (0x11-0x14) and every
+ * 32-bit output-mixer / scale coefficient must be in place BEFORE the amp
+ * leaves shutdown (SYS_CTRL_2 = 0x00, the final write).
+ *
+ * The 0.5x (0x00400000) cross-mix coefficients, the 0x56/0x57 post/pre
+ * scales and the 93.8% modulation limit (0x10 = 0x07) keep the BD bridge
+ * out of overcurrent when it drives a real waveform.  The generic TAS571x
+ * defaults (unity output mix, no scale, 98.4% limit, ~+22 dB master gain)
+ * overdrive the bridge into cross-conduction / PVDD brownout and hang the
+ * SoC the instant a non-silent signal is played.
+ *
+ * OSC_TRIM (0x1B) is loaded by the OSC_TRIM=0 write + 50 ms settle already
+ * done in tas571x_i2c_probe() right before this runs, so it is not
+ * re-written here (a non-factory value mis-trims the oscillator).
+ */
+static const struct reg_sequence tas5751_init_seq[] = {
+	{ 0x56,				0x0080d000 }, /* post-scale (32-bit) */
+	{ 0x57,				0x00020000 }, /* pre-scale (32-bit) */
+	{ TAS571X_MVOL_REG,		0x00f0 },     /* master volume -6 dB */
+	{ TAS571X_CH1_VOL_REG,		0x00c0 },     /* ch1 volume 0 dB */
+	{ TAS571X_CH2_VOL_REG,		0x00c0 },     /* ch2 volume 0 dB */
+	{ 0x50,				0x0f708010 }, /* output scale (32-bit) */
+	{ TAS571X_INPUT_MUX_REG,	0x00987772 }, /* BD input mux (ch1<-R ch2<-L) */
+	{ TAS571X_PWM_MUX_REG,		0x01002245 }, /* PWM output mux (BTL) */
+	{ 0x71,				0x00800000 }, /* ch1 output-mixer (32-bit) */
+	{ 0x75,				0x00800000 }, /* ch2 output-mixer (32-bit) */
+	{ TAS5717_CH1_LEFT_CH_MIX_REG,	0x00400000 }, /* 0x73: ch1 0.5x cross-mix */
+	{ TAS5717_CH1_RIGHT_CH_MIX_REG,	0x00400000 }, /* 0x72: ch1 0.5x cross-mix */
+	{ TAS5717_CH2_LEFT_CH_MIX_REG,	0x00400000 }, /* 0x76: ch2 0.5x cross-mix */
+	{ TAS5717_CH2_RIGHT_CH_MIX_REG,	0x00400000 }, /* 0x77: ch2 0.5x cross-mix */
+	{ TAS571X_SYS_CTRL_1_REG,	0x80 },	      /* DC-block HPF on */
+	{ TAS571X_SDI_REG,		0x05 },	      /* I2S 24-bit (hw_params re-sets) */
+	{ TAS571X_SOFT_MUTE_REG,	0x00 },	      /* soft un-mute */
+	{ TAS571X_VOL_CFG_REG,		0xf0 },	      /* volume config */
+	{ TAS571X_MODULATION_LIMIT_REG,	0x07 },	      /* modulation limit 93.8% */
+	{ TAS571X_BKND_ERR_REG,		0x07 },	      /* back-end error recovery */
+	{ TAS571X_IC_DELAY_CH1_REG,	0xb8 },	      /* BD inter-channel delays */
+	{ TAS571X_IC_DELAY_CH2_REG,	0x60 },
+	{ TAS571X_IC_DELAY_CH3_REG,	0xa0 },
+	{ TAS571X_IC_DELAY_CH4_REG,	0x48 },
+	{ TAS571X_PWM_CH_SDN_GROUP_REG,	0x30 },	      /* PWM shutdown group */
+	{ TAS571X_SYS_CTRL_2_REG,	0x00 },	      /* EXIT shutdown — MUST be last */
+};
+
+static int tas5751_init(struct tas571x_private *priv)
+{
+	return regmap_multi_reg_write(priv->regmap, tas5751_init_seq,
+				      ARRAY_SIZE(tas5751_init_seq));
+}
+
+static const struct snd_kcontrol_new tas5751_controls[] = {
+	/*
+	 * Master and channel volumes are RANGE-capped so no amixer or
+	 * alsactl-restore value can drive the BD bridge hotter than the stock
+	 * operating point (master -6 dB, channel 0 dB) and re-trigger the SoC
+	 * hang; attenuation below the cap is always allowed.  Both are 9-bit
+	 * fields at bit 1 (the hardware LSB is ignored, 0.25 dB/step) and a
+	 * larger field value is quieter, so the loudness cap is the field
+	 * minimum: 0x78 = -6 dB, 0x60 = 0 dB.
+	 */
+	SOC_SINGLE_RANGE_TLV("Master Volume", TAS571X_MVOL_REG,
+			     1, 0x78, 0x1ff, 1, tas5717_volume_tlv),
+	SOC_DOUBLE_R_RANGE_TLV("Speaker Volume",
+			       TAS571X_CH1_VOL_REG, TAS571X_CH2_VOL_REG,
+			       1, 0x60, 0x1ff, 1, tas5717_volume_tlv),
+	SOC_DOUBLE("Speaker Switch",
+		   TAS571X_SOFT_MUTE_REG,
+		   TAS571X_SOFT_MUTE_CH1_SHIFT, TAS571X_SOFT_MUTE_CH2_SHIFT,
+		   1, 1),
+	/*
+	 * The TAS5717 output-mixer coefficient controls ("CH1/CH2 Mixer
+	 * Volume") and biquads are deliberately not exposed for the TAS5751M:
+	 * the mixer controls write the 0x72/0x73/0x76/0x77 cross-mix
+	 * coefficients that tas5751_init() programs to the safe 0.5x BD
+	 * values, and letting userspace raise them back to unity reintroduces
+	 * the overcurrent hang.
+	 */
+};
+
+static const struct tas571x_chip tas5751_chip = {
+	.supply_names			= tas5721_supply_names,
+	.num_supply_names		= ARRAY_SIZE(tas5721_supply_names),
+	.controls			= tas5751_controls,
+	.num_controls			= ARRAY_SIZE(tas5751_controls),
+	.regmap_config			= &tas5717_regmap_config,
+	.vol_reg_size			= 2,
+	.init				= tas5751_init,
+};
+
 static const struct snd_soc_dapm_widget tas571x_dapm_widgets[] = {
 	SND_SOC_DAPM_DAC("DACL", NULL, SND_SOC_NOPM, 0, 0),
 	SND_SOC_DAPM_DAC("DACR", NULL, SND_SOC_NOPM, 0, 0),
@@ -913,6 +1026,14 @@ static int tas571x_i2c_probe(struct i2c_client *client)
 
 	usleep_range(50000, 60000);
 
+	if (priv->chip->init) {
+		ret = priv->chip->init(priv);
+		if (ret) {
+			dev_err(dev, "chip init failed: %d\n", ret);
+			goto disable_regs;
+		}
+	}
+
 	memcpy(&priv->component_driver, &tas571x_component, sizeof(priv->component_driver));
 	priv->component_driver.controls = priv->chip->controls;
 	priv->component_driver.num_controls = priv->chip->num_controls;
@@ -954,6 +1075,7 @@ static const struct of_device_id tas571x_of_match[] __maybe_unused = {
 	{ .compatible = "ti,tas5717", .data = &tas5717_chip, },
 	{ .compatible = "ti,tas5719", .data = &tas5717_chip, },
 	{ .compatible = "ti,tas5721", .data = &tas5721_chip, },
+	{ .compatible = "ti,tas5751", .data = &tas5751_chip, },
 	{ .compatible = "ti,tas5733", .data = &tas5733_chip, },
 	{ }
 };
@@ -965,6 +1087,7 @@ static const struct i2c_device_id tas571x_i2c_id[] = {
 	{ "tas5717", (kernel_ulong_t) &tas5717_chip },
 	{ "tas5719", (kernel_ulong_t) &tas5717_chip },
 	{ "tas5721", (kernel_ulong_t) &tas5721_chip },
+	{ "tas5751", (kernel_ulong_t) &tas5751_chip },
 	{ "tas5733", (kernel_ulong_t) &tas5733_chip },
 	{ }
 };
-- 
2.47.3

